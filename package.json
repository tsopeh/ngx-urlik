{
  "name": "ngx-urlik",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve demo-app",
    "build": "ng build ngx-urlik && ng build demo-app",
    "build:lib": "ng build ngx-urlik",
    "build:demo": "ng build demo-app",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-urlik --watch=false && ng test demo-app --watch=false",
    "test:lib": "ng test ngx-urlik --watch=false",
    "test:demo": "ng test demo-app --watch=false",
    "e2e": "playwright test",
    "typecheck": "npm run build:lib && node type-tests/generate-large-app.mjs && vitest run --config type-tests/vitest.config.mts",
    "lint": "ng lint && eslint type-tests playwright.config.ts",
    "lint:fix": "ng lint --fix && eslint --fix type-tests playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "dexie": "^4.4.7",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "ng-packagr": "^22.2.6",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
  }
}
