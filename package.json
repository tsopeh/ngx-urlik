{
  "name": "ngx-urlik",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve taste-track",
    "build": "ng build ngx-urlik && ng build taste-track",
    "build:lib": "ng build ngx-urlik",
    "build:demo": "ng build taste-track",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-urlik --watch=false && ng test taste-track --watch=false",
    "test:lib": "ng test ngx-urlik --watch=false",
    "test:demo": "ng test taste-track --watch=false",
    "e2e": "playwright test",
    "typecheck": "tsc -p type-tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "dexie": "^4.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
